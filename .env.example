# Copy to .env (git-ignored). Everything is optional; more settings are in README.md and server/README.md.

# Agent LLM: mock (no key needed) | groq | openrouter | openai | ollama | bedrock (uses your AWS credentials)
AGENT_PROVIDER=mock
AGENT_MODEL=
AGENT_API_KEY=

# Family messaging. TELEGRAM_FAKE=1 = no Telegram, demo member "Rahul". Never commit the token or join code.
TELEGRAM_FAKE=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_JOIN_CODE=
