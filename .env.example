# Harness
MCP_URL=http://localhost:8765/mcp
# Agent LLM: mock (no LLM) | bedrock | groq | openrouter | openai | ollama | any name + AGENT_BASE_URL
AGENT_PROVIDER=mock
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
# Bedrock uses your AWS credentials; AGENT_MODEL overrides BEDROCK_MODEL_ID
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Guardian MCP server. Copy to .env and fill in; all are optional.
GUARDIAN_HOST=
GUARDIAN_PORT=
GUARDIAN_ALLOWED_HOSTS=
GUARDIAN_BRANDS_FILE=
GUARDIAN_SCREENS_DIR=
GUARDIAN_SANDBOX_CONCURRENCY=
GUARDIAN_PERSON_NAME=
GUARDIAN_DATA_DIR=

# Family messaging (Telegram). Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FAKE=
TELEGRAM_JOIN_CODE=

# bedrock | anthropic | openai | none
LLM_PROVIDER=
