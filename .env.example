# Copy to .env (git-ignored). Everything is optional; more settings are in README.md and server/README.md.

# Agent LLM, blank = mock (no key needed) | groq | openrouter | openai | ollama | bedrock (uses your AWS credentials)
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_API_KEY=

# Family messaging. Set TELEGRAM_FAKE=1 for no Telegram (demo member "Rahul"). Never commit the token or join code.
TELEGRAM_FAKE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_JOIN_CODE=
